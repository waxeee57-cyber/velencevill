# Site URL (used for sitemap and OG tags)
NEXT_PUBLIC_SITE_URL=https://velencevill.hu

# Admin panel password (required — no fallback)
ADMIN_PASSWORD=your_secure_password_here

# Resend email service (required for form submissions)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@velencevill.hu
RESEND_TO_EMAIL=info@velencevill.hu

# Supabase (optional — for lead storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── baseline kiegészítés (2026-07-18) ────────────────────────────────
# A kódban használt, de innen eddig hiányzó kulcs.

# Supabase service role kulcs — CSAK szerveroldal (src/lib/supabaseAdmin.ts).
# Megkerüli az RLS-t. SOHA ne kerüljön NEXT_PUBLIC_ prefix elé és soha ne
# menjen kliensre. Forrás: Supabase Dashboard > Project Settings > API >
# service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
