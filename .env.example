# Site URL (sitemap, OG, canonical, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://velencevillkft.hu

# Admin panel password (required — no fallback)
ADMIN_PASSWORD=your_secure_password_here

# Resend email service (required for form submissions)
RESEND_API_KEY=
# Domaines küldéshez a Resenden verified domain kell (SPF/DKIM TXT a Rackhost zónában).
# Addig a TO maradhat Gmailen; FROM csak verified cím lehet.
RESEND_FROM_EMAIL=noreply@velencevillkft.hu
RESEND_TO_EMAIL=velencevillkft@gmail.com

# Vercel Blob — a dashboard Storage → Blob store automatikusan felteszi.
# BLOB_READ_WRITE_TOKEN=

# Opcionális: Google Search Console HTML-tag verification
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
