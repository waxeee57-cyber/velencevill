# Admin panel password (required ‚Äî no fallback)
ADMIN_PASSWORD=your_secure_password_here

# Resend email service (required for form submissions)
RESEND_API_KEY=
# Domaines k√ºld√©shez a Resenden verified domain kell (SPF/DKIM TXT a Rackhost z√≥n√°ban).
# Addig a TO maradhat Gmailen; FROM csak verified c√≠m lehet.
