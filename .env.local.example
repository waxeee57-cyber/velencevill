NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
RESEND_API_KEY=your_resend_api_key
RESEND_TO_EMAIL=info@velencevill.hu

# Admin jelszó — SZERVER OLDALI, soha nem kerül a kliens bundle-be.
