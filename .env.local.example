RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@velencevillkft.hu
RESEND_TO_EMAIL=velencevillkft@gmail.com

# Admin jelszó — SZERVER OLDALI, soha nem kerül a kliens bundle-be.
# Forrás: src/lib/adminAuth.ts + src/app/api/admin/auth/route.ts
# Erős, generált jelszót adj meg (pl. `openssl rand -base64 24`).
# Valós értéket ebbe a fájlba SOHA ne írj — csak .env.local + Vercel env.
ADMIN_PASSWORD=

NEXT_PUBLIC_SITE_URL=https://velencevillkft.hu

# Microsoft Clarity (session replay + hőtérkép) — ingyenes.
# clarity.microsoft.com → új projekt → Settings → Project ID (10 karakteres kód).
# Üresen hagyva a Clarity script NEM töltődik be. Sütikonszenthez kötve
# (src/components/ConsentAnalytics.tsx).
NEXT_PUBLIC_CLARITY_ID=

# Clarity Data Export API token (opcionális) — az admin „Clarity” tab élő
# mutatóihoz. Clarity → Settings → Data Export → Generate new API token.
# SZERVER OLDALI, nincs NEXT_PUBLIC_ prefix. Limit: 10 lekérés/projekt/nap.
CLARITY_API_TOKEN=
